[Unit]
Description=kuhwa ebook on-demand cache fetcher (object storage -> /data/cache)
Documentation=file:///opt/kuhwa/etxfetch/etxfetch.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# 그룹을 www-data 로 지정해 캐시 파일을 ubuntu:www-data 로 생성한다
# (nginx worker = www-data 가 읽을 수 있도록)
Group=www-data
WorkingDirectory=/opt/kuhwa/etxfetch
ExecStart=/opt/kuhwa/etxfetch/.venv/bin/python /opt/kuhwa/etxfetch/etxfetch.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM

# 파일 생성 권한: dir 0750 / file 0640 (etxfetch.py 가 umask 0027 설정)
UMask=0027

# 캐시 상한 (GiB). 초과 시 오래된 unit(LRU)을 통째로 삭제한다.
# 보호 대상: base(include/ebook/1), share(_share) — 이것들은 eviction 되지 않는다.
Environment=ETX_CACHE_CAP_GIB=5

# --- 하드닝 ---
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/cache /var/lib/etxfetch
# oci SDK 는 전용 venv(.venv)에만 있으므로 홈 전체를 숨겨도 import 된다.
# (2026-10-08 전환: ProtectHome=true 하 PREFLIGHT_PASS 실측 — /home 음영 상태에서
#  signer·get_namespace·get_bucket 성공. ~/.local 버전으로 되돌리면 재시작 루프.)
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# 스트리밍 다운로드라 실사용 RSS 는 ~50MB (대형 mp4 277MiB 실측)
MemoryMax=768M
TasksMax=128
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
