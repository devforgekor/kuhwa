# 표준: host nginx 가 유일한 80/443 종착지 (Mozilla Intermediate + 보안 헤더)
# 라우팅: /                       → 정적 포털
#         /app/etextbook/         → 전자교과서 (완전 프리픽스 + on-demand 캐시)
#         /app/pdf/               → pdf2sheet (기존 /pdf/ 및 pdfkuhwa 서브도메인 흡수)
#         /schedule/              → 정적 학사일정 (var/www/schedule + 정적 calendar.ics)
#         /timetable/ · /cashbook/ → 자체호스팅 uvicorn (8091 / 8092, systemd)
#         /edufinebot/            → /app/edufinebot/ 로 301 (트레일링 슬래시)
#         (Phase4) 이관4경로 응답에 분류 breadcrumb + 관련 서비스 fixed 막대 sub_filter 주입
#         /ebook/ /viewer/ /resource/ /_share/ /pdf/ → 신규 경로로 301 (북마크 보호)
#
# 전자교과서 캐시: /data/cache/app/etextbook/ (URL 미러)
#   miss 시 @etx_fetch → etxfetch(127.0.0.1:8090) 가 object storage 에서 받아
#   캐시에 쓰고 X-Accel-Redirect 로 돌려준다.

server {
	listen 80;
	listen [::]:80;
	server_name kuhwa.duckdns.org;

	limit_req zone=general burst=40 nodelay;
	limit_conn addr 20;
	include /etc/nginx/snippets/security-headers.conf;

	# ACME HTTP-01 웹루트 (standalone 종속성 제거)
	location /.well-known/acme-challenge/ {
		root /var/www/certbot;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name kuhwa.duckdns.org;

	ssl_certificate     /etc/letsencrypt/live/kuhwa.duckdns.org/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/kuhwa.duckdns.org/privkey.pem;

	client_max_body_size 64m;
	limit_req zone=general burst=40 nodelay;
	limit_conn addr 20;
	include /etc/nginx/snippets/security-headers.conf;

	root  /var/www/kuhwa;
	index index.html;

	# --- 정적 포털 ---
	location / {
		try_files $uri $uri/ =404;
	}

	# ============================================================
	# 전자교과서 — 완전 프리픽스 /app/etextbook/
	# ============================================================

	# 진입 → 단원선택 홈 (뷰어에 contentInformationURL 을 줘야 콘텐츠를 찾는다)
	# 뷰어를 직접 열면 설정의 자리표시자 content.url="./books/ebook" 를 써서
	# fileNotExist 팝업("다운로드 받지 않은 단원입니다") 으로 떨어진다.
	location = /app/etextbook {
		return 301 /app/etextbook/resource/include/main/index.html;
	}
	location = /app/etextbook/ {
		return 301 /app/etextbook/resource/include/main/index.html;
	}

	# 파라미터 없는 뷰어 디렉토리 직접 진입도 동일하게 홈으로
	location = /app/etextbook/viewer/ebook {
		return 301 /app/etextbook/resource/include/main/index.html;
	}
	location = /app/etextbook/viewer/ebook/ {
		return 301 /app/etextbook/resource/include/main/index.html;
	}

	# 뷰어 셸 — 컨테이너가 이미지 내장 viewer 를 서빙 (prefix 만 제거)
	location /app/etextbook/viewer/ {
		proxy_pass http://127.0.0.1:8081/viewer/;
		proxy_http_version 1.1;
		proxy_set_header Host              $host;
		proxy_set_header X-Real-IP         $remote_addr;
		proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		# upstream 이 압축하면 sub_filter 가 본문을 못 읽는다
		proxy_set_header Accept-Encoding   "";
		proxy_cache_bypass $http_upgrade;
		proxy_read_timeout 300s;
		limit_req zone=general burst=200 nodelay;
		limit_conn addr 200;
		include /etc/nginx/snippets/etextbook-subfilter.conf;
	}

	# 裸 디렉토리(트레일링 슬래시)는 index.html 을 직접 서빙한다.
	# try_files $uri 는 디렉토리를 매칭 못 해 @etx_fetch 로 떨어져 502 가 났다.
	location = /app/etextbook/resource/ {
		root /data/cache;
		index index.html;
		open_file_cache_errors off;
		limit_conn addr 200;
	}

	# 콘텐츠 — host 캐시, miss 시 etxfetch
	location /app/etextbook/resource/ {
		root /data/cache;
		# 전역 open_file_cache_errors on 이 ENOENT 를 30s 캐시해
		# X-Accel 재요청이 또 미스 → 무한루프에 빠진다. 위치 단위로 끈다.
		open_file_cache_errors off;
		limit_req zone=general burst=200 nodelay;
		limit_conn addr 200;
		index index.html;
		include /etc/nginx/snippets/etextbook-subfilter.conf;
		try_files $uri @etx_fetch;
	}

	# 공유 에셋 (뷰어의 루트절대경로 /_share/ 가 여기로 온다)
	location /app/etextbook/_share/ {
		root /data/cache;
		open_file_cache_errors off;
		limit_req zone=general burst=200 nodelay;
		limit_conn addr 200;
		include /etc/nginx/snippets/etextbook-subfilter.conf;
		try_files $uri @etx_fetch;
	}

	location /app/etextbook/ {
		root /data/cache;
		open_file_cache_errors off;
		limit_req zone=general burst=200 nodelay;
		limit_conn addr 200;
		index index.html;
		include /etc/nginx/snippets/etextbook-subfilter.conf;
		try_files $uri $uri/ @etx_fetch;
	}

	# 캐시 미스 → etxfetch (파일을 받아 캐시에 쓰고 X-Accel-Redirect)
	# limit_conn 이 서버 수준(20) 그대로면 miss 가 몰릴 때 429 로 막힌다.
	location @etx_fetch {
		proxy_pass http://127.0.0.1:8090;
		proxy_set_header Host              $host;
		proxy_set_header X-Real-IP         $remote_addr;
		proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Original-URI    $uri;
		proxy_connect_timeout 5s;
		proxy_read_timeout 300s;
		proxy_send_timeout 300s;
		limit_conn addr 200;
	}

	# ============================================================
	# PDF 변환 도구 — /app/pdf/ (기존 /pdf/ 및 pdfkuhwa 흡수)
	# ============================================================
	location = /app/pdf {
		return 301 /app/pdf/;
	}

	location /app/pdf/ {
		proxy_pass http://127.0.0.1:8000/;
		# 캐시 재검증 강화: Cache-Control 이 없어 구 스타일시트가
		# 휴리스틱 캐시에 남았었다(헤더 부재 = 원인). expires 는
		# add_header 상속을 끊지 않는다.
		expires -1;
		proxy_http_version 1.1;
		proxy_set_header Host              $host;
		proxy_set_header X-Real-IP         $remote_addr;
		proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Accept-Encoding   "";
		proxy_redirect ~^/(.*)$ /app/pdf/$1;
		proxy_read_timeout    300s;
		proxy_send_timeout    300s;
		proxy_request_buffering on;

		# 앱이 절대경로(/login, /static 등)를 출력하므로 /app/pdf 접두로 재작성
		# sub_filter_types 는 text/html 에 추가된다(nginx 동작 실측 확인)
		sub_filter_types application/javascript;
		sub_filter 'href="/'                      'href="/app/pdf/';
		sub_filter 'src="/'                       'src="/app/pdf/';
		sub_filter 'action="/'                    'action="/app/pdf/';
		sub_filter 'window.location = "/'         'window.location = "/app/pdf/';
		sub_filter 'window.location="/'           'window.location="/app/pdf/';
		sub_filter 'location.href = "/'           'location.href = "/app/pdf/';
		sub_filter 'location.href="/'             'location.href="/app/pdf/';
		sub_filter "fetch('/"                     "fetch('/app/pdf/";
		sub_filter 'fetch("/'                     'fetch("/app/pdf/';
		sub_filter '</body>' '<style>.kx{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;padding:6px 12px;background:#f6f8fa;border-top:1px solid #d1d9e0;font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Malgun Gothic",sans-serif;color:#57606a;box-sizing:border-box}.kx a{color:#0969da;text-decoration:none}.kx a:hover{text-decoration:underline}.kx .c{color:#1f2328;font-weight:600}.kx .p{color:#656d76}.kx .s{color:#8c959f}.kx .r{margin-left:auto;color:#57606a}body{padding-bottom:44px}@media (max-width:640px){.kx .r{margin-left:0}}</style><nav class="kx" aria-label="분류 경로"><a href="/">kuhwa</a><span class="s">›</span><span class="p">교육 도구</span><span class="s">›</span><span class="c">PDF 변환 도구</span></nav></body>';
		sub_filter_once off;
	}

	# ============================================================
	# 품목내역 생성기 (쿠팡 장바구니∩결제 교집합) — 정적 ~/app/edufinebot/public
	# ============================================================
	location = /app/edufinebot {
		return 301 /app/edufinebot/;
	}
	location /app/edufinebot/ {
		alias /var/www/edufinebot/;
		index index.html;
		sub_filter '</body>' '<style>.kx{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;padding:6px 12px;background:#f6f8fa;border-top:1px solid #d1d9e0;font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Malgun Gothic",sans-serif;color:#57606a;box-sizing:border-box}.kx a{color:#0969da;text-decoration:none}.kx a:hover{text-decoration:underline}.kx .c{color:#1f2328;font-weight:600}.kx .p{color:#656d76}.kx .s{color:#8c959f}.kx .r{margin-left:auto;color:#57606a}body{padding-bottom:44px}@media (max-width:640px){.kx .r{margin-left:0}}</style><nav class="kx" aria-label="분류 경로"><a href="/">kuhwa</a><span class="s">›</span><span class="p">교육 도구</span><span class="s">›</span><span class="c">품목내역 생성기</span></nav></body>';
		sub_filter_once on;                # public/index.html 실측 </body> 1회
	}

	# ============================================================
	# Phase3 자체호스팅 (계획서 6장(a)) — schedule / timetable / cashbook
	#   2026-10-10 실측 + 스크래치 검증 통과. 기존 /app/* ·301 블록은 불변.
	# ============================================================

	# bare → 정규 슬래시
	location = /schedule  { return 301 /schedule/; }
	location = /timetable { return 301 /timetable/; }
	location = /cashbook  { return 301 /cashbook/; }
	location = /edufinebot { return 301 /app/edufinebot/; }	# bare → 정규 슬래시 (기존 = /app/edufinebot 는 별개)
	# (5c-3) "= " 정확일치는 /edufinebot/ 를 못 잡아 404 였음 → prefix 로 보완
	location /edufinebot/ { rewrite ^/edufinebot(/.*)?$ /app/edufinebot$1 permanent; }

	# --- schedule: 정적 (root 패턴 — alias+try_files 함정 회피) ---
	location /schedule/ {
		root /var/www;                 # → /var/www/schedule/...
		index index.html;
		try_files $uri $uri/ =404;
		sub_filter '</body>' '<style>.kx{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;padding:6px 12px;background:#f6f8fa;border-top:1px solid #d1d9e0;font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Malgun Gothic",sans-serif;color:#57606a;box-sizing:border-box}.kx a{color:#0969da;text-decoration:none}.kx a:hover{text-decoration:underline}.kx .c{color:#1f2328;font-weight:600}.kx .p{color:#656d76}.kx .s{color:#8c959f}.kx .r{margin-left:auto;color:#57606a}body{padding-bottom:44px}@media (max-width:640px){.kx .r{margin-left:0}}</style><nav class="kx" aria-label="분류 경로"><a href="/">kuhwa</a><span class="s">›</span><span class="p">나이스</span><span class="s">›</span><span class="c">학사일정</span><span class="r">관련: <a href="/timetable/">교사 시간표</a> · <a href="/app/etextbook/">전자교과서 뷰어</a></span></nav></body>';
		sub_filter_once on;                # public/index.html 실측 </body> 1회
		# data/*.json 은 application/json → sub_filter 대상(text/html) 아님
	}

	# 정적 .ics (fetch-schedule.js 가 선생성, 2026-10-10 사용자 결정)
	# nginx mime.types(93행)에 ics 매핑이 없어 기본 type 이 octet-stream 이 되므로 명시.
	location = /schedule/data/calendar.ics {
		root /var/www;
		types { text/calendar ics; }
		default_type text/calendar;
	}
	# 기존 ICS 구독 경로 보존 (kuhwa /api/calendar.ics 는 현재 404)
	location = /api/calendar.ics { return 301 /schedule/data/calendar.ics; }

	# --- timetable: FastAPI (kuhwa-timetable.service, 127.0.0.1:8091) ---
	# --root-path 는 scope/url_for/OAuth redirect_uri 에만 반영되고, HTML 리터럴과
	# RedirectResponse("/calendar/login") 에는 반영되지 않는다(2026-10-10 실측).
	# 그래서 sub_filter(본문) + proxy_redirect(Location) 으로 /timetable 접두를 다시 붙인다.
	location /timetable/ {
		proxy_pass http://127.0.0.1:8091/;      # URI 포함 → location 접두 치환
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Accept-Encoding "";      # sub_filter 가 본문을 읽으려면 업스트림 gzip 해제 필수
		proxy_redirect ~^/(.*)$ /timetable/$1;    # 상대 Location 재접두
		sub_filter 'href="/'   'href="/timetable/';
		sub_filter 'action="/' 'action="/timetable/';
		sub_filter '</body>' '<style>.kx{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;padding:6px 12px;background:#f6f8fa;border-top:1px solid #d1d9e0;font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Malgun Gothic",sans-serif;color:#57606a;box-sizing:border-box}.kx a{color:#0969da;text-decoration:none}.kx a:hover{text-decoration:underline}.kx .c{color:#1f2328;font-weight:600}.kx .p{color:#656d76}.kx .s{color:#8c959f}.kx .r{margin-left:auto;color:#57606a}body{padding-bottom:44px}@media (max-width:640px){.kx .r{margin-left:0}}</style><nav class="kx" aria-label="분류 경로"><a href="/">kuhwa</a><span class="s">›</span><span class="p">나이스</span><span class="s">›</span><span class="c">교사 시간표</span><span class="r">관련: <a href="/schedule/">학사일정</a></span></nav></body>';
		sub_filter_once off;                      # 기본 on → 모든 occurrence 를 바꾸려면 off
		# sub_filter_types 는 지정하지 않는다 — 기본 text/html, 명시하면 duplicate MIME warn
	}

	# --- cashbook: FastAPI (kuhwa-cashbook.service, 127.0.0.1:8092, D2(b) 이관) ---
	# 템플릿 절대경로 9종(href/action/hx-*) + RedirectResponse("/login") → 동일 처리
	location /cashbook/ {
		proxy_pass http://127.0.0.1:8092/;      # URI 포함 → location 접두 치환
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Accept-Encoding "";
		proxy_redirect ~^/(.*)$ /cashbook/$1;
		sub_filter 'href="/'      'href="/cashbook/';
		sub_filter 'action="/'    'action="/cashbook/';
		sub_filter 'hx-put="/'    'hx-put="/cashbook/';
		sub_filter 'hx-post="/'   'hx-post="/cashbook/';
		sub_filter 'hx-delete="/' 'hx-delete="/cashbook/';
		sub_filter 'src="/' 'src="/cashbook/';
		sub_filter '</body>' '<style>.kx{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;display:flex;flex-wrap:wrap;gap:6px 10px;align-items:center;padding:6px 12px;background:#f6f8fa;border-top:1px solid #d1d9e0;font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Malgun Gothic",sans-serif;color:#57606a;box-sizing:border-box}.kx a{color:#0969da;text-decoration:none}.kx a:hover{text-decoration:underline}.kx .c{color:#1f2328;font-weight:600}.kx .p{color:#656d76}.kx .s{color:#8c959f}.kx .r{margin-left:auto;color:#57606a}body{padding-bottom:44px}@media (max-width:640px){.kx .r{margin-left:0}}</style><nav class="kx" aria-label="분류 경로"><a href="/">kuhwa</a><span class="s">›</span><span class="p">나이스</span><span class="s">›</span><span class="c">예산 내역</span></nav></body>';
		sub_filter_once off;
	}

	# ============================================================
	# 구 경로 → 신 경로 301 (기존 북마크 보호)
	# 정규식 location 은 prefix 보다 뒤에서 평가되므로 /app/* 를 침범하지 않는다.
	# ============================================================
	location ~ ^/ebook/?$ {
		return 301 /app/etextbook/resource/include/main/index.html;
	}
	location ~ ^/viewer/(.*)$ {
		return 301 /app/etextbook/viewer/$1$is_args$args;
	}
	location ~ ^/resource/(.*)$ {
		return 301 /app/etextbook/resource/$1$is_args$args;
	}
	location ~ ^/_share/(.*)$ {
		return 301 /app/etextbook/_share/$1$is_args$args;
	}
	location = /pdf {
		return 301 /app/pdf/;
	}
	location ~ ^/pdf/(.*)$ {
		return 301 /app/pdf/$1$is_args$args;
	}
}
